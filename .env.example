# API key gerada em https://stitch.withgoogle.com/settings (secao API Keys). Nao coloque a chave real neste arquivo.
STITCH_API_KEY=

# Local / app
DATABASE_URL=postgresql://postgres:senha@localhost:5432/mtghelper
AUTH_SECRET=

# Docker Compose na VPS (ver docs/deploy-hostinger-vps.md)
POSTGRES_PASSWORD=
APP_IMAGE=ghcr.io/rsdutra/mtghelper:latest
